<?xml version="1.0" encoding="utf-8"?>
<!--
  Revela opening on Android 12+: the frame is there, and the light rises from its bottom edge,
  like a picture coming up in the developer tray. Geometry from branding/revela/logo.py.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
            <group android:scaleX="0.62" android:scaleY="0.62" android:translateX="23" android:translateY="23">
                <path android:fillColor="#F2EBE0" android:fillType="evenOdd"
                    android:pathData="M24,20 L76,20 Q84,20 84,28 L84,72 Q84,80 76,80 L24,80 Q16,80 16,72 L16,28 Q16,20 24,20 Z M26,27 L74,27 Q77,27 77,30 L77,70 Q77,73 74,73 L26,73 Q23,73 23,70 L23,30 Q23,27 26,27 Z" />
                <group android:name="window">
                    <!-- Only what is inside the frame shows: the light comes up from below its edge. -->
                    <clip-path android:pathData="M23,27 L77,27 L77,73 L23,73 Z" />
                    <group android:name="sun" android:translateY="18">
                        <path android:fillColor="#FF7A3D" android:pathData="M33,73 A17,17 0 0,1 67,73 Z" />
                    </group>
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="sun">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateY" android:valueFrom="18" android:valueTo="0"
                android:duration="760" android:startOffset="80"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
