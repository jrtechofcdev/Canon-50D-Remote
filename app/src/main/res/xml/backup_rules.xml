<!--
   Android 11 and older. The options go to the Google backup (the app's own .json backup in Ajustes
   is the full one). The photo database stays out: it points to files in folders whose permission
   only works on this phone, and it holds the delivery clients' names and phones.
-->
<full-backup-content>
    <exclude domain="database" path="." />
</full-backup-content>
