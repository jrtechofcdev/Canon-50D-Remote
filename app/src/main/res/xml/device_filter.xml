<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Match ANY Canon camera (Vendor ID 1193 is 0x04A9) -->
    <usb-device vendor-id="1193" />

    <!-- Match ANY digital camera using PTP/MTP (Class 6 - Image, Subclass 1, Protocol 1) -->
    <usb-device class="6" subclass="1" protocol="1" />
    <usb-device class="6" subclass="1" />
    <usb-device class="6" />
</resources>
