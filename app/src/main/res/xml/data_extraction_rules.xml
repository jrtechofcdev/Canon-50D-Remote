<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12 and newer. Same rule as backup_rules.xml for the Google backup; a direct transfer to a
   new phone (cable or Wi-Fi) brings everything, since it is the same photographer moving phones.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
</data-extraction-rules>
